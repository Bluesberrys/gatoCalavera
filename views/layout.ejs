<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%- title %> - Gato calavera</title>
  <link rel="icon" href="./imgs/gatoCalaveraIcon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Knewave&family=Urbanist:wght@100..900&display=swap" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="./css/styles.css" />
  <% if (cssFiles && cssFiles.length) {%>
  <% cssFiles.forEach((cssFile) => { %>
  <link rel="stylesheet" href="./css/<%= cssFile %>" />
  <% }) %>
  <% } %>
</head>

<body>
  <!-- Header -->
  <header class="header">
    <div class="logo">
      <a href="/">
        <img src="./imgs/gatoCalaveraIcon.svg" alt="Wonejo Rosa Logo" />
      </a>
    </div>

    <nav class="menu">
      <div class="links-menu">
        <a href="/">Inicio</a>
        <div class="dropdown-container">
          <a href="#" class="dropdown-trigger" id="products-link">
            Productos <i class="bi bi-caret-down-square"></i>
          </a>
          <div class="dropdown-menu" id="products-dropdown">
            <ul>
              <li><a href="/category/camisetas">Camisetas</a></li>
              <li><a href="/category/hoodies">Hoodies & Sudaderas</a></li>
              <li><a href="/category/pantalones">Pantalones</a></li>
              <li><a href="/category/accesorios">Accesorios</a></li>
              <li><a href="/category/zapatos">Zapatos</a></li>
              <li><a href="/category/chaquetas">Chaquetas</a></li>
              <li><a href="/category/gorras">Gorras</a></li>
              <li><a href="/category/ofertas">Ofertas Especiales</a></li>
            </ul>
          </div>
        </div>
      </div>
      <div class="search-bar">
        <input type="text" name="text" placeholder="Search" />
        <button class="search-btn">
          <i class="bi bi-search"></i>
        </button>
      </div>
      <div class="icons-menu">
        <a href="#" class="chekout" id="cart-button">
          <i class="bi bi-bag-fill"></i>
          <span class="cart-count" id="cart-count">0</span>
        </a>
        <a href="#" class="profile"><i class="bi bi-person-circle"></i></a>
      </div>
    </nav>

    <div class="burger-menu">
      <i class="bi bi-list"></i>
    </div>
  </header>

  <!-- Cart Overlay -->
  <div id="cart-overlay" class="overlay"></div>

  <div id="cart-sidebar" class="sidebar">
    <div class="sidebar-content">
      <div class="sidebar-header">
        <h2><i class="bi bi-bag-fill"></i> Tu Carrito</h2>
        <button id="close-cart" class="close-btn">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>

      <div class="cart-items" id="cart-items">
        <!-- Cart items will be dynamically added here -->
        <div class="empty-cart">
          <i class="bi bi-bag-x"></i>
          <p>Tu carrito está vacío</p>
          <small>Agrega algunos productos para comenzar</small>
        </div>
      </div>

      <div class="cart-footer">
        <div class="cart-total">
          <strong>Total: $<span id="cart-total">0.00</span></strong>
        </div>
        <button class="checkout-btn" id="checkout-btn" disabled>
          <i class="bi bi-credit-card"></i> Proceder al Pago
        </button>
        <button class="continue-shopping" id="continue-shopping">
          Continuar Comprando
        </button>
      </div>
    </div>
  </div>
  <!-- Content -->
  <main>
    <%- content %>
  </main>
  <!-- Footer -->
  <footer class="footer">
    <div class="footer-links">
      <a href="/">Inicio</a>
      <a href="/about">Sobre nosotros</a>
      <a href="/contact">Contacto</a>
    </div>
    <div class="footer-social">
      <a href="#"><i class="bi bi-facebook"></i></a>
      <a href="#"><i class="bi bi-instagram"></i></a>
      <a href="#"><i class="bi bi-twitter"></i></a>
    </div>
    <div class="footer-credits">
      <p>&copy; 2025 Gato Calavera. Todos los derechos reservados.</p>
    </div>
  </footer>
  <!-- Scripts -->
  <script src="./js/app.js"></script>

</body>

</html>