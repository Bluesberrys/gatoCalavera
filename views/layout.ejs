<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%- title %> - Gato calavera</title>
  <link rel="icon" href="./imgs/gatoCalaveraIcon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Knewave&family=Urbanist:wght@100..900&display=swap" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="./css/styles.css" />
  <% if (cssFiles && cssFiles.length) {%>
  <% cssFiles.forEach((cssFile) => { %>
  <link rel="stylesheet" href="./css/<%= cssFile %>" />
  <% }) %>
  <% } %>
</head>

<body>
  <!-- Header -->
  <header class="header">
    <div class="logo">
      <a href="/">
        <img src="./imgs/gatoCalaveraIcon.svg" alt="Wonejo Rosa Logo" />
      </a>
    </div>

    <nav class="menu">
      <div class="links-menu">
        <a href="/">Inicio</a>
        <a href="#" class="" id="products-link">Productos <i class="bi bi-caret-down-square"></i></a>
        <div class="dropdown-menu" id="products-dropdown">
          <ul>
            <li><a href="#">Category 1</a></li>
            <li><a href="#">Category 2</a></li>
            <li><a href="#">Category 3</a></li>
            <!-- Add more categories as needed -->
          </ul>
        </div>
      </div>
      <div class="search-bar">
        <input type="text" name="text" placeholder="Search" />
        <button class="search-btn">
          <i class="bi bi-search"></i>
        </button>
      </div>
      <div class="icons-menu">
        <a href="#" class="chekout" id="cart-button"><i class="bi bi-bag-fill"></i></a>
        <a href="#" class="profile"><i class="bi bi-person-circle"></i></a>
      </div>
      <div id="cart-sidebar" class="sidebar">
        <div class="sidebar-content">
          <h2>Your Cart</h2>
          <!-- Cart items will be dynamically added here -->
          <button id="close-cart">Close</button>
        </div>
      </div>
    </nav>

    <div class="burger-menu">
      <i class="bi bi-list"></i>
    </div>
  </header>
  <!-- Content -->
  <main>
    <%- content %>
  </main>
  <!-- Footer -->
  <footer class="footer">
    <div class="footer-links">
      <a href="/">Inicio</a>
      <a href="/about">Sobre nosotros</a>
      <a href="/contact">Contacto</a>
    </div>
    <div class="footer-social">
      <a href="#"><i class="bi bi-facebook"></i></a>
      <a href="#"><i class="bi bi-instagram"></i></a>
      <a href="#"><i class="bi bi-twitter"></i></a>
    </div>
    <div class="footer-credits">
      <p>&copy; 2025 Gato Calavera. Todos los derechos reservados.</p>
    </div>
  </footer>
  <!-- Scripts -->
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      const burgerMenu = document.querySelector(".burger-menu");
      const menu = document.querySelector(".menu");

      burgerMenu.addEventListener("click", function() {
        menu.classList.toggle("active");
      });
    });

    document.getElementById('cart-button').addEventListener('click', function(event) {
      event.preventDefault();
      document.getElementById('cart-sidebar').classList.toggle('active');
    });
    document.getElementById('close-cart').addEventListener('click', function() {
      document.getElementById('cart-sidebar').classList.remove('active');
    });
    // Optional: Close the dropdown when clicking outside
    document.addEventListener('click', function(event) {
      const dropdown = document.getElementById('products-dropdown');
      if (!event.target.matches('#products-link')) {
        dropdown.style.display = 'none';
      }
    });
  </script>
</body>

</html>